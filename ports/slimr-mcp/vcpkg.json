{
  "name": "slimr-mcp",
  "version": "0.1.3",
  "description": "Header-only typed MCP servers and JSON CLIs",
  "dependencies": [
    {
      "name": "slimr-bugsink",
      "version>=": "0.1.1"
    },
    {
      "name": "slimr-json",
      "version>=": "0.1.1"
    },
    {
      "name": "slimr-reflect",
      "version>=": "0.1.1"
    }
  ],
  "features": {
    "http": {
      "description": "Streamable HTTP and OAuth resource-server support via cpp-httplib",
      "dependencies": [
        {
          "name": "cpp-httplib",
          "default-features": false,
          "features": [
            "openssl"
          ]
        }
      ]
    },
    "tests": {
      "description": "Dependencies for the standalone test suite",
      "dependencies": [
        {
          "name": "cpp-httplib",
          "default-features": false,
          "features": [
            "openssl"
          ]
        },
        {
          "name": "slimr-test",
          "version>=": "0.1.1"
        }
      ]
    }
  }
}
